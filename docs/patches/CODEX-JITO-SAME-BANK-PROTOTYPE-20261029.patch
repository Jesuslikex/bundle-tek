+    #[test]
+    fn test_same_bank_endpoint_binds_fee_to_frozen_simulation_bank() {
+        let rpc = RpcHandler::start();
+        let bank = rpc.working_bank();
+        let transactions = encoded_transfers(&rpc, 2);
+        bank.freeze();
+        let request = |replace_recent_blockhash| json!({
+            "jsonrpc": "2.0", "id": 7, "method": "simulateBundleWithSameBankFees",
+            "params": [{"encodedTransactions": transactions}, {
+                "simulationBank": {"slot": bank.slot()},
+                "skipSigVerify": true,
+                "replaceRecentBlockhash": replace_recent_blockhash,
+                "preExecutionAccountsConfigs": [null, null],
+                "postExecutionAccountsConfigs": [null, null]
+            }]
+        });
+        let call = |replace| {
+            let response = rpc.io.handle_request_sync(&request(replace).to_string(), rpc.meta.clone()).unwrap();
+            serde_json::from_str::<serde_json::Value>(&response).unwrap()
+        };
+        let result = call(false);
+        assert_eq!(result["result"]["context"]["slot"], bank.slot());
+        assert_eq!(result["result"]["value"]["bankHash"], bank.hash().to_string());
+        assert_eq!(result["result"]["value"]["independentFees"], json!([TEST_SIGNATURE_FEE, TEST_SIGNATURE_FEE]));
+        let hashes: Vec<String> = transactions.iter().map(|encoded| {

+.frame {
+  min-width: 0;
+}
+
+.views {
+  min-width: 0;
+}
+
+.frame > .views {
+  display: flex;
+  flex-direction: column;
+  gap: 0;
+  border: 1px solid var(--border);
+  border-radius: 12px;
+}
+
+.navigation {
+  display: flex;
+  flex: 0 0 auto;
+  gap: 4px;
+  padding: 6px;
+  overflow-x: auto;
+  border-bottom: 1px solid var(--border);
+}
+
+.navigation > button {
+  flex: 0 0 auto;
+  min-height: 36px;
+  padding: 7px 12px;
+  border: 1px solid transparent;
+  border-radius: 6px;
+  color: var(--muted-foreground);
+  background: transparent;
+  font: inherit;
+  font-size: 13px;
+  cursor: pointer;
+}
+
+.navigation > button[aria-selected='true'] {
+  color: var(--foreground);
+  border-color: var(--border);
+  background: var(--secondary);
+}
+
+.navigation > button:focus-visible,
+.panel:focus-visible {
+  outline: 2px solid var(--primary);
+  outline-offset: -2px;
+}
+
+.panel {
+  min-width: 0;
+  padding: 12px;
+}
+
+.notice {
+  margin: 0;
+  padding: 3px 12px;
+  color: var(--muted-foreground);
+  font-size: 11px;
+  line-height: 16px;
+}
+
+.panel[hidden] {
+  display: none !important;
+}
+
+.frame.docked {
+  height: var(--workspace-fit-height);
+  grid-template-rows: var(--workspace-chart-height) minmax(196px, 1fr);
+  gap: 12px;
+}
+
+.frame.docked > [aria-label='Open token chart'],
+.frame.docked > :global(.imported-workspace-trading) {
+  min-height: 0;
+  max-height: none;
+  overflow: auto;
+  overscroll-behavior: contain;
+}
+
+.frame.docked > .views {
+  min-height: 0;
+  overflow: hidden;
+}
+
+.docked .panel {
+  min-height: 0;
+  overflow: auto;
+  overscroll-behavior: contain;
+  scrollbar-gutter: stable;
+}
+
+@media (min-width: 1101px) and (min-height: 640px) {
+  :global(.imported-token-details):has(> .frame)
+    :global(.imported-token-header-actions)
+    > :global(.token-project-picker) {
+    margin: 0;
+  }
+
+  :global(.imported-token-details):has(> .frame)
+    :global(.imported-token-header)
+    :global(.token-project-picker)[open],
+  :global(.imported-token-details):has(> .frame)
+    :global(.imported-token-actions-menu)[open] {
+    width: 100%;
+  }
+
+  :global(.imported-token-details):has(> .frame)
+    :global(.imported-token-header-actions) {
+    flex-direction: row;
+    flex-wrap: wrap;
+    justify-content: flex-end;
+    align-items: start;
+    max-width: min(65%, 700px);
+  }
+
+  :global(.imported-token-details):has(> .frame)
